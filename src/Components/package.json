{
  "name": "@nfdi4plants/arcitisa-components",
  "version": "0.0.0",
  "description": "Customizable React components for ontology annotation, based on ARCitISA and the ARC.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/assets/arcitisa-components.css"
  },
  "scripts": {
    "clean": "dotnet fable clean -e fs.ts --yes",
    "fable": "dotnet fable ./src/Arcitisa.Components.fsproj --lang ts",
    "start": "npm run fable -- --watch --run vite",
    "dev": "npm run start",
    "test": "npm run clean && npm run fable -- --noCache && npx vitest run",
    "test:run": "npm run test",
    "test:watch": "npm run clean && npm run fable -- --watch --run npx vitest",
    "test:rtl": "npm run clean && npm run fable -- --noCache && npx vitest run --project=rtl",
    "test:unit": "npm run clean && npm run fable -- --noCache && npx vitest run --project=unit",
    "test:storybook": "npm run clean && npm run fable -- --noCache && npx vitest run --project=storybook",
    "prelink": "npm run build",
    "storybook": "npm run fable -- --watch --run storybook dev -p 6006",
    "storybook:no-compile": "storybook dev -p 6006",
    "prebuild:net": "npx @tailwindcss/cli -i ./tailwind.css -o ./src/arcitisa-components.css -m",
    "build": "npm run clean && npm run fable -- --fableLib @fable-org/fable-library-ts --noCache -e fs.ts -o ./src/dist && vite build",
    "build:net": "dotnet pack ./src/Arcitisa.Components.fsproj",
    "prebuild:storybook": "npm run fable -- --noCache",
    "build:storybook": "storybook build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nfdi4plants/ARCitISA.git"
  },
  "keywords": [
    "rdm",
    "ontology",
    "term",
    "react"
  ],
  "author": "Kevin Frey <freymaurer@gmx.de>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nfdi4plants/ARCitISA/issues"
  },
  "homepage": "https://github.com/nfdi4plants/ARCitISA#readme",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fable-org/fable-library-ts": "^2.12.0",
    "@floating-ui/react": "^0.27.15",
    "@lezer/highlight": "^1.2.5",
    "@lezer/json": "^1.0.3",
    "@nfdi4plants/arctrl": "^3.0.0-alpha.4",
    "@tanstack/react-virtual": "^3.13.2",
    "@uidotdev/usehooks": "^2.4.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "codemirror": "^6.0.2",
    "elkjs": "^0.9.3",
    "fuse.js": "^7.1.0",
    "hast-util-from-html": "^2.0.3",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mermaid": "^11.12.3",
    "micromark-extension-gfm": "^3.0.0",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^1.3.1",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
